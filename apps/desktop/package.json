{
  "name": "kalem-desktop",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "Kalem Desktop — a Word-like Markdown editor built with Electron",
  "author": "Yusuf Koçak",
  "license": "MIT",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm typecheck && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "e2e": "pnpm build && playwright test",
    "package": "pnpm build && electron-builder --config electron-builder.yml",
    "package:dir": "pnpm build && electron-builder --dir --config electron-builder.yml"
  },
  "devDependencies": {
    "@kalem-editor/core": "workspace:^",
    "@kalem-editor/editor": "workspace:^",
    "@kalem-editor/plugin-autosave": "workspace:^",
    "@kalem-editor/plugin-code-highlight": "workspace:^",
    "@kalem-editor/plugin-find-replace": "workspace:^",
    "@kalem-editor/plugin-image-upload": "workspace:^",
    "@kalem-editor/plugin-outline": "workspace:^",
    "@kalem-editor/plugin-source-mode": "workspace:^",
    "@kalem-editor/plugin-word-count": "workspace:^",
    "@kalem-editor/themes": "workspace:^",
    "@kalem-editor/ui": "workspace:^",
    "@kalem-editor/viewer": "workspace:^",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "docx": "^9.8.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "mammoth": "^1.13.0",
    "mermaid": "^11.17.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.0"
  }
}
