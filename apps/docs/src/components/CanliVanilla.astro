---
/**
 * Canlı örnek — vanilla  (İş listesi: F6-03)
 *
 * Çerçeve yok: bir `<div>`, bir `new Editor(...)`, bir `mountUi(...)`.
 * Aşağıdaki `<script>` Astro tarafından paketlenip **istemcide**
 * çalışıyor; sunucuda hiçbir şey yapmıyor.
 */
import "./canli.css";
import type { Dil } from "./ornek-belge";

interface Props {
	dil?: Dil;
}

const { dil = "tr" } = Astro.props;
---

<div class="canli">
	<p class="canli-rozet">
		<b>vanilla</b> · <code>new Editor(el)</code> + <code>mountUi(editor)</code>
	</p>
	<div class="canli-yazi kalem-theme" data-canli-vanilla lang={dil}></div>
	<pre class="canli-cikti" data-canli-vanilla-cikti></pre>
</div>

<script>
	import { Editor } from "@kalem/editor";
	import { mountUi } from "@kalem/ui";
	import { canliEtiket, type Dil, ornekBelge } from "./ornek-belge";

	const kap = document.querySelector<HTMLElement>("[data-canli-vanilla]");
	const cikti = document.querySelector<HTMLElement>("[data-canli-vanilla-cikti]");

	if (kap !== null && cikti !== null) {
		const dil: Dil = kap.lang === "en" ? "en" : "tr";
		const editor = new Editor(kap, {
			value: ornekBelge(dil),
			lang: dil,
			label: canliEtiket(dil, "vanilla"),
			onChange: (markdown) => {
				cikti.textContent = markdown;
			},
		});
		mountUi(editor, { toolbar: "both" });
		cikti.textContent = editor.getValue();
	}
</script>
