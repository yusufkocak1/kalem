{
  "name": "@kalem/react",
  "version": "1.0.0",
  "description": "React wrapper for Kalem — <KalemEditor /> and useKalem()",
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "react"
  ],
  "license": "MIT",
  "author": "Yusuf Koçak",
  "homepage": "https://github.com/yusufkocak1/kalem/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufkocak1/kalem.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/yusufkocak1/kalem/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "kalem-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@kalem/core": "workspace:^",
    "@kalem/editor": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
