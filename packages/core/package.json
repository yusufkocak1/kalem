{
  "name": "@kalem-editor/core",
  "version": "1.0.0",
  "description": "Markdown AST, parser and lossless serializer — no DOM, zero dependencies",
  "keywords": [
    "markdown",
    "parser",
    "serializer",
    "ast",
    "mdast",
    "commonmark",
    "gfm"
  ],
  "license": "MIT",
  "author": "Yusuf Koçak",
  "homepage": "https://github.com/yusufkocak1/kalem/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufkocak1/kalem.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/yusufkocak1/kalem/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "kalem-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./commands": {
      "kalem-source": "./src/commands.ts",
      "import": {
        "types": "./dist/commands.d.ts",
        "default": "./dist/commands.js"
      },
      "require": {
        "types": "./dist/commands.d.cts",
        "default": "./dist/commands.cjs"
      }
    },
    "./html": {
      "kalem-source": "./src/html.ts",
      "import": {
        "types": "./dist/html.d.ts",
        "default": "./dist/html.js"
      },
      "require": {
        "types": "./dist/html.d.cts",
        "default": "./dist/html.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
