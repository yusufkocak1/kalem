{
  "name": "@kalem/themes",
  "version": "0.0.0",
  "description": "Typography and theme tokens for Kalem — plain CSS, no build step",
  "keywords": [
    "markdown",
    "editor",
    "css",
    "theme"
  ],
  "license": "MIT",
  "author": "Yusuf Koçak",
  "homepage": "https://github.com/yusufkocak1/kalem/tree/main/packages/themes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufkocak1/kalem.git",
    "directory": "packages/themes"
  },
  "bugs": {
    "url": "https://github.com/yusufkocak1/kalem/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "css"
  ],
  "exports": {
    "./tokens.css": "./css/tokens.css",
    "./viewer.css": "./css/viewer.css",
    "./editor.css": "./css/editor.css",
    "./ui.css": "./css/ui.css",
    "./dark.css": "./css/dark.css",
    "./minimal.css": "./css/minimal.css",
    "./plugin-image.css": "./css/plugin-image.css",
    "./plugin-code.css": "./css/plugin-code.css",
    "./plugin-find.css": "./css/plugin-find.css",
    "./plugin-outline.css": "./css/plugin-outline.css",
    "./plugin-word-count.css": "./css/plugin-word-count.css",
    "./plugin-source.css": "./css/plugin-source.css",
    "./plugin-autosave.css": "./css/plugin-autosave.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
