{
  "name": "@kalem-editor/wc",
  "version": "1.0.0",
  "description": "Kalem as a form-associated custom element — <kalem-editor>, no framework needed",
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "web-components",
    "custom-element"
  ],
  "license": "MIT",
  "author": "Yusuf Koçak",
  "homepage": "https://github.com/yusufkocak1/kalem/tree/main/packages/wc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufkocak1/kalem.git",
    "directory": "packages/wc"
  },
  "bugs": {
    "url": "https://github.com/yusufkocak1/kalem/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": [
    "./dist/define-side-effect.js",
    "./dist/define-side-effect.cjs",
    "./dist/kalem-editor.iife.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "kalem-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./define": {
      "kalem-source": "./src/define-side-effect.ts",
      "import": {
        "types": "./dist/define-side-effect.d.ts",
        "default": "./dist/define-side-effect.js"
      },
      "require": {
        "types": "./dist/define-side-effect.d.cts",
        "default": "./dist/define-side-effect.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@kalem-editor/editor": "workspace:^"
  },
  "devDependencies": {
    "@kalem-editor/core": "workspace:^",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
