{
  "name": "@kalem/plugin-code-highlight",
  "version": "1.0.0",
  "description": "Kalem plugin: code block highlighting with lazily loaded language packs",
  "keywords": [
    "markdown",
    "editor",
    "kalem-plugin",
    "syntax-highlighting"
  ],
  "license": "MIT",
  "author": "Yusuf Koçak",
  "homepage": "https://github.com/yusufkocak1/kalem/tree/main/packages/plugin-code-highlight#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufkocak1/kalem.git",
    "directory": "packages/plugin-code-highlight"
  },
  "bugs": {
    "url": "https://github.com/yusufkocak1/kalem/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "kalem-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./langs/*": {
      "import": {
        "types": "./dist/langs/*.d.ts",
        "default": "./dist/langs/*.js"
      },
      "require": {
        "types": "./dist/langs/*.d.cts",
        "default": "./dist/langs/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@kalem/editor": "workspace:^"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
